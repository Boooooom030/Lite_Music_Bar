<Window x:Class="MusicBar.Settings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MusicBar 设置" Icon="/Assets/icon.ico"
        Width="1000" Height="700" MinWidth="780" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable, DengXian, Microsoft YaHei UI"
        FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        Background="{DynamicResource WindowBrush}">
    <Grid Background="{DynamicResource WindowOverlayBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
            <Grid Margin="15,22,15,17">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="9,0,0,30">
                    <Image Source="/Assets/icon.ico" Width="42" Height="42"
                           VerticalAlignment="Center"/>
                    <TextBlock Text="MusicBar" FontFamily="Segoe UI Variable, Segoe UI"
                               FontSize="17" FontWeight="SemiBold" Margin="12,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="1,0,1,22">
                    <TextBox x:Name="SearchBox" Style="{StaticResource SearchStyle}"
                             AutomationProperties.Name="查找设置" TextChanged="SearchTextChanged"/>
                    <TextBlock x:Name="SearchHint" Text="查找设置" FontSize="13"
                               Foreground="{DynamicResource MutedBrush}"
                               Margin="12,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                    <Path Data="M 8,1 A 6,6 0 1 1 7.9,1 M 12.5,12.5 L 17,17"
                          Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5"
                          Width="16" Height="16" Stretch="Uniform"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Margin="0,0,11,0" IsHitTestVisible="False"/>
                </Grid>

                <StackPanel Grid.Row="2">
                    <RadioButton x:Name="NavTaskbar" Tag="taskbar" GroupName="Pages"
                                 Style="{StaticResource NavigationStyle}" Checked="NavigationChecked">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource TextBrush}"
                                  StrokeThickness="1.5" Data="M 2,3 L 18,3 18,14 2,14 Z M 7,17 L 13,17 M 10,14 L 10,17"/>
                            <TextBlock Text="任务栏" Margin="13,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavLyrics" Tag="lyrics" GroupName="Pages"
                                 Style="{StaticResource NavigationStyle}" Checked="NavigationChecked">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource TextBrush}"
                                  StrokeThickness="1.5" Data="M 3,4 L 17,4 M 3,9 L 14,9 M 3,14 L 11,14"/>
                            <TextBlock Text="歌词" Margin="13,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavAudio" Tag="audio" GroupName="Pages"
                                 Style="{StaticResource NavigationStyle}" Checked="NavigationChecked">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource TextBrush}"
                                  StrokeThickness="1.5" Data="M 2,11 L 5,11 7,5 10,16 13,7 15,11 18,11"/>
                            <TextBlock Text="音频频谱" Margin="13,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <TextBlock x:Name="NoSearchResults" Text="没有找到匹配的设置" FontSize="13"
                               Foreground="{DynamicResource MutedBrush}" Margin="15,12,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="4,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="重新读取" Style="{StaticResource TextButtonStyle}"
                                Click="ReloadClicked"/>
                        <Button Content="恢复默认" Style="{StaticResource TextButtonStyle}"
                                Click="ResetClicked" Margin="5,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer x:Name="SettingsScrollViewer" Grid.Column="1"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="42,31,42,38" MaxWidth="830" HorizontalAlignment="Stretch">
                <TextBlock x:Name="PageTitle" Text="任务栏" FontSize="30"
                           FontWeight="SemiBold" Margin="0,0,0,32"/>

                <StackPanel x:Name="PageTaskbar">
                    <TextBlock Text="音乐栏" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Width="20" Height="20" Stretch="Uniform" Stroke="{DynamicResource TextBrush}"
                                  StrokeThickness="1.5" VerticalAlignment="Center"
                                  Data="M 4,3 L 16,3 16,17 4,17 Z M 7,8 L 13,8 M 7,12 L 13,12"/>
                            <TextBlock Grid.Column="1" Text="锁定位置" FontWeight="SemiBold"
                                       Margin="13,0,15,0" VerticalAlignment="Center"/>
                            <CheckBox x:Name="PositionLockedToggle" Grid.Column="2"
                                      Style="{StaticResource ToggleStyle}" Click="SettingChanged"
                                      AutomationProperties.Name="锁定音乐栏位置"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PageLyrics" Visibility="Collapsed">
                    <TextBlock Text="歌词显示" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Width="20" Height="20" Stretch="Uniform" Stroke="{DynamicResource TextBrush}"
                                  StrokeThickness="1.5" VerticalAlignment="Center"
                                  Data="M 3,4 L 17,4 M 3,9 L 14,9 M 3,14 L 11,14"/>
                            <TextBlock Grid.Column="1" Text="显示同步歌词" FontWeight="SemiBold"
                                       Margin="13,0,15,0" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ShowLyricsToggle" Grid.Column="2"
                                      Style="{StaticResource ToggleStyle}" Click="SettingChanged"
                                      AutomationProperties.Name="显示同步歌词"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="获取来源" FontSize="17" FontWeight="SemiBold" Margin="0,29,0,12"/>
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Width="20" Height="20" Stretch="Uniform" Stroke="{DynamicResource TextBrush}"
                                  StrokeThickness="1.5" VerticalAlignment="Center"
                                  Data="M 4,2 L 16,2 16,18 4,18 Z M 7,6 L 13,6 M 7,10 L 13,10 M 7,14 L 11,14"/>
                            <TextBlock Grid.Column="1" Text="歌词来源" FontWeight="SemiBold"
                                       Margin="13,0,18,0" VerticalAlignment="Center"/>
                            <ComboBox x:Name="SourcePicker" Grid.Column="2" Width="150"
                                      Style="{StaticResource PickerStyle}" SelectedValuePath="Tag"
                                      SelectionChanged="SettingChanged" VerticalAlignment="Center"
                                      AutomationProperties.Name="歌词来源"
                                      ToolTip="自动选择会优先查询当前播放器对应的平台">
                                <ComboBoxItem Content="自动选择" Tag="auto" Style="{StaticResource PickerItemStyle}"/>
                                <ComboBoxItem Content="网易云音乐" Tag="netease" Style="{StaticResource PickerItemStyle}"/>
                                <ComboBoxItem Content="QQ 音乐" Tag="qq" Style="{StaticResource PickerItemStyle}"/>
                                <ComboBoxItem Content="酷狗音乐" Tag="kugou" Style="{StaticResource PickerItemStyle}"/>
                                <ComboBoxItem Content="汽水音乐" Tag="soda" Style="{StaticResource PickerItemStyle}"/>
                                <ComboBoxItem Content="LRCLIB" Tag="lrclib" Style="{StaticResource PickerItemStyle}"/>
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PageAudio" Visibility="Collapsed">
                    <TextBlock Text="音频采集" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Width="20" Height="20" Stretch="Uniform" Stroke="{DynamicResource TextBrush}"
                                  StrokeThickness="1.5" VerticalAlignment="Center"
                                  Data="M 2,11 L 5,11 7,5 10,16 13,7 15,11 18,11"/>
                            <TextBlock Grid.Column="1" Text="FFT 音频来源" FontWeight="SemiBold"
                                       Margin="13,0,18,0" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CapturePicker" Grid.Column="2" Width="150"
                                      Style="{StaticResource PickerStyle}" SelectedValuePath="Tag"
                                      SelectionChanged="SettingChanged" VerticalAlignment="Center"
                                      AutomationProperties.Name="FFT 音频来源"
                                      ToolTip="旧版 Windows 无法按进程采集时，会使用系统混音">
                                <ComboBoxItem Content="当前播放器" Tag="player" Style="{StaticResource PickerItemStyle}"/>
                                <ComboBoxItem Content="系统混音" Tag="system" Style="{StaticResource PickerItemStyle}"/>
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>

                <TextBlock x:Name="StatusText" Foreground="{DynamicResource ErrorBrush}"
                           FontSize="13" Margin="2,24,0,0" TextWrapping="Wrap"
                           Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
