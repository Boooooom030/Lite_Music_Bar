<Window x:Class="MusicBar.Settings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MusicBar 设置" Width="740" Height="690" MinWidth="620" MinHeight="580"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI"
        Background="{DynamicResource WindowBrush}">
    <Grid Margin="30,26,30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="2,0,0,24">
            <TextBlock Text="MusicBar" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock Text="设置" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,4"/>
            <TextBlock Text="调整歌词显示、任务栏交互和音频频谱。"
                       Foreground="{DynamicResource MutedBrush}" FontSize="13"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="22"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="任务栏显示" FontSize="18" FontWeight="SemiBold"
                                   Margin="0,0,0,19"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="显示同步歌词" FontWeight="SemiBold"/>
                                <TextBlock Text="在歌曲信息下方显示当前歌词。"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="ShowLyricsToggle" Grid.Column="1"
                                      Style="{StaticResource ToggleStyle}"
                                      VerticalAlignment="Center" Margin="18,0,0,0"/>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource BorderBrush}"
                                Margin="0,18,0,18"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="锁定音乐栏位置" FontWeight="SemiBold"/>
                                <TextBlock Text="防止拖动改变任务栏中的位置，按钮仍可点击。"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="PositionLockedToggle" Grid.Column="1"
                                      Style="{StaticResource ToggleStyle}"
                                      VerticalAlignment="Center" Margin="18,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="22"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="歌词来源" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="自动模式会优先尝试当前播放器对应的平台。"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="12" Margin="0,5,0,18"/>
                        <WrapPanel>
                            <RadioButton x:Name="SourceAuto" Content="自动" Tag="auto"
                                         GroupName="LyricsSource" Style="{StaticResource ChoiceStyle}"/>
                            <RadioButton x:Name="SourceNetEase" Content="网易云" Tag="netease"
                                         GroupName="LyricsSource" Style="{StaticResource ChoiceStyle}"/>
                            <RadioButton x:Name="SourceQQ" Content="QQ 音乐" Tag="qq"
                                         GroupName="LyricsSource" Style="{StaticResource ChoiceStyle}"/>
                            <RadioButton x:Name="SourceKugou" Content="酷狗" Tag="kugou"
                                         GroupName="LyricsSource" Style="{StaticResource ChoiceStyle}"/>
                            <RadioButton x:Name="SourceSoda" Content="汽水" Tag="soda"
                                         GroupName="LyricsSource" Style="{StaticResource ChoiceStyle}"/>
                            <RadioButton x:Name="SourceLrclib" Content="LRCLIB" Tag="lrclib"
                                         GroupName="LyricsSource" Style="{StaticResource ChoiceStyle}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="22"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="FFT 音频来源" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="切换频谱采集的声音范围。"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="12" Margin="0,5,0,18"/>
                        <WrapPanel>
                            <RadioButton x:Name="CapturePlayer" Content="当前播放器" Tag="player"
                                         GroupName="CaptureMode" Style="{StaticResource ChoiceStyle}"/>
                            <RadioButton x:Name="CaptureSystem" Content="系统混音" Tag="system"
                                         GroupName="CaptureMode" Style="{StaticResource ChoiceStyle}"/>
                        </WrapPanel>
                        <TextBlock Text="较旧的 Windows 版本无法按进程采集时，会使用系统混音。"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="2,18,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="准备就绪"
                               Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                    <TextBlock x:Name="ConfigPathText" FontSize="11"
                               Foreground="{DynamicResource MutedBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="350"
                               Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="重新读取" Style="{StaticResource SecondaryButtonStyle}"
                            Click="ReloadClicked" Margin="0,0,8,0"/>
                    <Button Content="恢复默认" Style="{StaticResource SecondaryButtonStyle}"
                            Click="ResetClicked" Margin="0,0,8,0"/>
                    <Button Content="保存设置" Style="{StaticResource PrimaryButtonStyle}"
                            Click="SaveClicked"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
