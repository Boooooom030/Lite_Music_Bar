<Window x:Class="MusicBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Music Bar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Visibility="Collapsed">

    <Window.Resources>
        <!-- Mini control button style for taskbar bar -->
        <Style x:Key="MiniControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Play/Pause slightly larger button -->
        <Style x:Key="MiniPlayButtonStyle" TargetType="Button" BasedOn="{StaticResource MiniControlButtonStyle}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
        </Style>
    </Window.Resources>

    <!-- Canvas covering the taskbar -->
    <Canvas x:Name="RootCanvas" Background="Transparent" ClipToBounds="False">
        <!-- Taskbar Embedded Bar -->
        <Border x:Name="MainContainer"
                Width="280" Height="36"
                CornerRadius="6" Background="#EE1E1E1E"
                BorderBrush="#44FFFFFF" BorderThickness="1"
                Padding="5,3,5,2"
                MouseLeftButtonDown="OnBarMouseDown"
                MouseMove="OnBarMouseMove"
                MouseLeftButtonUp="OnBarMouseUp">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="2"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>   <!-- Album Art 26x26 -->
                        <ColumnDefinition Width="*"/>    <!-- Title & Artist -->
                        <ColumnDefinition Width="Auto"/> <!-- Prev, Play/Pause, Next -->
                    </Grid.ColumnDefinitions>

                    <!-- Album Art Thumbnail -->
                    <Border Grid.Column="0" CornerRadius="4" ClipToBounds="True"
                            Width="24" Height="24" VerticalAlignment="Center">
                        <Grid>
                            <!-- Placeholder Note Icon -->
                            <Border Background="#2AFFFFFF" x:Name="ArtPlaceholder">
                                <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="12" Foreground="#AAA"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <Image x:Name="AlbumArt" Stretch="UniformToFill"/>
                        </Grid>
                    </Border>

                    <!-- Track Info (Single-line compact) -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                Margin="6,0,4,0">
                        <TextBlock x:Name="TitleText"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="White"
                                   TextTrimming="CharacterEllipsis"
                                   Text="Music Bar"/>
                        <TextBlock x:Name="ArtistText"
                                   FontSize="9.5"
                                   Foreground="#AAAAAA"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,1,0,0"
                                   Text="未在播放"/>
                    </StackPanel>

                    <!-- Mini Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,1,0">
                        <Button Content="&#xE892;" Style="{StaticResource MiniControlButtonStyle}"
                                Click="OnPrevious" ToolTip="上一首"/>
                        <Button x:Name="PlayPauseBtn" Content="&#xE768;"
                                Style="{StaticResource MiniPlayButtonStyle}"
                                Click="OnPlayPause" ToolTip="播放 / 暂停"/>
                        <Button Content="&#xE893;" Style="{StaticResource MiniControlButtonStyle}"
                                Click="OnNext" ToolTip="下一首"/>
                    </StackPanel>
                </Grid>

                <!-- Bottom 2px accent progress line -->
                <Grid Grid.Row="1" Margin="0,1,0,0">
                    <ProgressBar x:Name="BottomProgress"
                                 Minimum="0" Maximum="100" Value="0"
                                 Height="2"
                                 BorderThickness="0"
                                 Background="#2AFFFFFF"
                                 Foreground="#1DB954"
                                 IsHitTestVisible="False"/>
                </Grid>
            </Grid>
        </Border>
    </Canvas>
</Window>
